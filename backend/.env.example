# Zonalyze backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Application ---
APP_NAME=Zonalyze
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false                   # true = echo SQL to console (dev only); keep false otherwise

# --- CORS & rate limiting ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limiting is OFF by default; enable it before a public launch.
RATE_LIMIT_ENABLED=false
RATE_LIMIT=240/minute         # "N/second|minute|hour", applied globally per client IP
# Only set true when running behind YOUR OWN reverse proxy (cloud deploy) so the
# limiter reads the real client IP from X-Forwarded-For. Never true when the
# backend is directly exposed (clients could spoof the header).
TRUST_PROXY_HEADERS=false

# --- PostgreSQL (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zonalyze_db
DB_USER=zonalyze_app          # use a least-privilege role, NOT the postgres superuser
DB_PASSWORD=                  # required; app should refuse to start if empty

# --- Mapbox (optional; reverse-geocoding fallback for competitor addresses) ---
MAPBOX_ACCESS_TOKEN=

# --- Authentication (Clerk) — OPTIONAL ---
# Leave BLANK to keep auth disabled (the app runs open, exactly as before).
# Set CLERK_ISSUER to turn auth ON; the backend then requires a valid Clerk
# session token on every non-public endpoint. Also set the matching publishable
# key as VITE_CLERK_PUBLISHABLE_KEY in frontend/.env. Find the issuer in the
# Clerk dashboard (Configure -> API keys / JWT). No secret key is needed here — the
# backend verifies tokens with Clerk's public JWKS keys.
CLERK_ISSUER=            # e.g. https://your-app-123.clerk.accounts.dev
CLERK_JWKS_URL=          # optional; defaults to <CLERK_ISSUER>/.well-known/jwks.json
# Optional Clerk JWT public key (PEM with newlines written as \\n). When set,
# tokens can be verified without a runtime network call to the JWKS endpoint.
CLERK_JWT_KEY=

# --- MongoDB cache (optional; app runs without it) ---
MONGODB_URI=                  # e.g. mongodb+srv://user:pass@cluster/...  (keep secret)
MONGODB_DB_NAME=zonalyze
MONGODB_CACHE_ENABLED=true
MONGODB_DNS_RESOLVERS=8.8.8.8,1.1.1.1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2500
MONGODB_CONNECT_TIMEOUT_MS=2500
MONGODB_SOCKET_TIMEOUT_MS=5000

# --- MongoDB cache collections / TTLs (optional; sensible defaults exist) ---
OPERATING_PROFILE_CACHE_COLLECTION=operating_profiles
OPERATING_PROFILE_CACHE_TTL_HOURS=168
BUSINESS_RESOLUTION_CACHE_COLLECTION=business_resolutions
BUSINESS_RESOLUTION_CACHE_TTL_HOURS=168
MARKET_MAP_CACHE_COLLECTION=market_maps
MARKET_MAP_CACHE_TTL_HOURS=24

# --- Hosted AI (optional; any OpenAI-compatible provider) ---
# Ollama only runs on a developer's own machine, so in a cloud deploy every AI
# panel reports "unavailable". Setting AI_API_KEY routes the SAME prompts to a
# hosted API instead. Leave blank to keep using Ollama.
#
# This app sends FEW but LARGE prompts (the operating-profile call is 4-7k tokens),
# so tokens-per-minute is the limit that bites, not requests-per-day:
#   Gemini (recommended). Key: https://aistudio.google.com/apikey
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-3.5-flash-lite     (gemini-2.5-flash* 404s: "no longer
#                                          available to new users" as of Nov 2026;
#                                          confirm your live quota in AI Studio)
#   Groq — 14.4k req/day but only 6k TPM; one profile call can exhaust a minute.
#     AI_BASE_URL=https://api.groq.com/openai/v1
#     AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter — 50 req/day without credits; handy for trying models.
#     AI_BASE_URL=https://openrouter.ai/api/v1
#     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite

# --- Local Ollama AI (used only when AI_API_KEY is blank) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Comma-separated allowlist of models a client may request via the chat API.
# The default model above is always allowed; leave blank to allow only it.
OLLAMA_ALLOWED_MODELS=
OLLAMA_JSON_SCHEMA=1
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=8192
OLLAMA_JSON_TIMEOUT_SECONDS=180
OLLAMA_JSON_NUM_PREDICT=2200
OLLAMA_JSON_NUM_CTX=8192

# --- OSM taginfo (optional; dynamic business tag resolution) ---
OSM_TAGINFO_BASE_URL=https://taginfo.openstreetmap.org
OSM_TAGINFO_MIN_COUNT=100
OSM_TAGINFO_TIMEOUT_SECONDS=6

# --- Overpass (map competitors/transit/commercial) reliability ---
# Comma-separated mirrors tried in order (failover keeps the map alive).
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# Server-side query budget embedded in the Overpass QL.
OVERPASS_TIMEOUT_SECONDS=12
# Socket timeout per endpoint attempt (MUST be > OVERPASS_TIMEOUT_SECONDS).
OVERPASS_HTTP_TIMEOUT_SECONDS=16
# How long a failed lookup is cached before retrying (seconds).
OVERPASS_FAILURE_CACHE_SECONDS=45
# Disk cache: successful results persist to app/data/generated/overpass_cache.json
# and are served stale when Overpass is unreachable. Prefetch on a good network:
#   python -m app.scripts.prefetch_overpass_cache
OVERPASS_DISK_CACHE_MAX_ENTRIES=3000
# Circuit breaker: after this many consecutive failures, skip the network for the
# cooldown so requests return instantly from cache instead of hanging.
OVERPASS_CIRCUIT_FAIL_THRESHOLD=3
OVERPASS_CIRCUIT_COOLDOWN_SECONDS=30
