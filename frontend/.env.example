# BestSpot frontend environment variables (Vite).
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars are exposed to the browser,
# so NEVER put server secrets here. A Mapbox *public* token is fine; keep secret tokens server-side.

# Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Mapbox public token for client-side map rendering (public scope only)
VITE_MAPBOX_TOKEN=

# Clerk authentication (OPTIONAL) — publishable key (pk_test_... / pk_live_...).
# Leave BLANK to keep the app open with no sign-in screen (default). Set it to
# turn on the Clerk sign-in gate. This is a public key, safe for the browser.
VITE_CLERK_PUBLISHABLE_KEY=
