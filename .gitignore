# --- Track ONLY the small runtime files a fresh clone needs (<200 KB total) ---
# The large raw data and all *.pkl model weights stay ignored; see DEPLOYMENT.md
# for how teammates obtain those. The nested rules below re-include specific
# small files that live under the ignored data/ and models/ directories.
!backend/app/data/
backend/app/data/*
!backend/app/data/market/
backend/app/data/market/*
!backend/app/data/market/competition_observations_seed.csv
!backend/app/data/market/demand_observations_seed.csv
!backend/app/data/market/lease_cost_observations_seed.csv
!backend/app/data/market/observed_footfall_counts.csv
!backend/app/data/processed/
backend/app/data/processed/*
!backend/app/data/processed/ontario_csd_selected_features_2021.csv
!backend/app/data/synthetic/
backend/app/data/synthetic/*
!backend/app/data/synthetic/zonalyze_business_taxonomy_seed.csv
!backend/app/ml/models/
backend/app/ml/models/*
!backend/app/ml/models/feature_columns.json
!backend/app/ml/models/model_metadata.json